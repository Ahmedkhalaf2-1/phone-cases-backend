# Copy this file to .env and fill in real values for local development.
# Never commit a real .env file.

NODE_ENV=development
# Port 3010 is used instead of the common default 3000 to reduce the
# chance of clashing with another local project.
PORT=3010

# Base URL the API is served from (used to build absolute media URLs, etc.)
APP_URL=http://localhost:3010

# PostgreSQL connection used by Prisma (docker-compose "postgres" service by default).
# Host port 5544 is intentionally non-default to avoid clashing with any
# other PostgreSQL instance already running on your machine.
DATABASE_URL="postgresql://phonecases:phonecases_dev_password@localhost:5544/phonecases?schema=public"

# Used only by `npm run test:e2e` (docker-compose "postgres_test" service by default)
TEST_DATABASE_URL="postgresql://phonecases:phonecases_test_password@localhost:5545/phonecases_test?schema=public"

# JWT secrets - generate strong random values for real environments, e.g.:
#   openssl rand -base64 48
JWT_ACCESS_SECRET=replace-with-a-long-random-secret-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret
JWT_REFRESH_EXPIRES_IN=7d

# Comma-separated list of origins allowed to call this API (no wildcard in production)
CORS_ORIGINS=http://localhost:5173

# Media storage: "local" for filesystem storage under ./uploads (development only)
# or "s3" for an S3-compatible object storage bucket (configure the block below).
MEDIA_STORAGE_DRIVER=local
MEDIA_LOCAL_DIR=uploads
MEDIA_MAX_FILE_SIZE_BYTES=5242880

# Only required when MEDIA_STORAGE_DRIVER=s3
MEDIA_S3_ENDPOINT=
MEDIA_S3_REGION=
MEDIA_S3_BUCKET=
MEDIA_S3_ACCESS_KEY_ID=
MEDIA_S3_SECRET_ACCESS_KEY=
MEDIA_S3_PUBLIC_URL_BASE=

# Default storefront currency, ISO 4217 code, minor-unit based (e.g. EGP piastres)
DEFAULT_CURRENCY=EGP

# How long a checkout-time stock reservation is held before it expires and
# is automatically released (see docs/BUSINESS_RULES.md).
RESERVATION_TTL_MINUTES=15

# No payment provider has been selected yet (see docs/DECISIONS.md).
# "none" disables public order creation entirely (503 ORDERING_UNAVAILABLE).
# "mock_dev_only" is a clearly-labeled, non-production simulation that lets
# the order pipeline be tested end-to-end without a real payment
# integration - refused at startup if NODE_ENV=production.
PAYMENT_METHOD=none

# Bootstrap-only: creates the first OWNER_ADMIN staff account on `npm run seed`
# if no staff users exist yet. Not read at server startup. Use a strong password
# and rotate it immediately after first login in any shared environment.
SEED_OWNER_ADMIN_EMAIL=owner@example.com
SEED_OWNER_ADMIN_PASSWORD=change-me-now-12345
